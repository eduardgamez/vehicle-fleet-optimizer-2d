{
  "taskGroups": [
    {
      "taskCount": 1,
      "parallelism": 1,
      "taskSpec": {
        "runnables": [
          {
            "script": {
              "text": "gcloud storage rsync -r {{BUCKET}}/modelos /datos/modelos && gcloud storage rsync -r {{BUCKET}}/muestras /datos/muestras && gcloud storage rsync -r {{BUCKET}}/escenarios /datos/escenarios"
            }
          },
          {
            "container": {
              "imageUri": "{{IMAGEN}}",
              "entrypoint": "python",
              "commands": [
                "finalizar.py",
                "--fase6", "/datos/modelos/fase6",
                "--muestras", "/datos/muestras",
                "--escenarios", "/datos/escenarios",
                "--salida", "/datos/modelos/politica.pt"
              ],
              "volumes": [
                "/datos:/datos",
                "/var/lib/nvidia/lib64:/usr/local/nvidia/lib64",
                "/var/lib/nvidia/bin:/usr/local/nvidia/bin"
              ],
              "options": "--privileged"
            }
          }
        ],
        "computeResource": {
          "cpuMilli": 8000,
          "memoryMib": 30000
        },
        "maxRetryCount": 0,
        "maxRunDuration": "43200s",
        "volumes": [
          {
            "deviceName": "trabajo",
            "mountPath": "/datos"
          }
        ],
        "environment": {
          "variables": {
            "TDR_BUCKET": "{{BUCKET}}",
            "TDR_DATOS": "/datos",
            "LD_LIBRARY_PATH": "/usr/local/nvidia/lib64"
          }
        }
      }
    }
  ],
  "allocationPolicy": {
    "instances": [
      {
        "installGpuDrivers": true,
        "policy": {
          "machineType": "g2-standard-8",
          "provisioningModel": "STANDARD",
          "disks": [
            {
              "deviceName": "trabajo",
              "newDisk": {
                "sizeGb": 100,
                "type": "pd-balanced"
              }
            }
          ]
        }
      }
    ]
  },
  "logsPolicy": {
    "destination": "CLOUD_LOGGING"
  }
}
